{
  "name": "whitebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc -b && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "typecheck": "tsc -b --pretty false && tsc -p convex/tsconfig.json --pretty false && tsc -p scripts/tsconfig.json --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && python3 -m unittest discover -s hermes/plugins/whitebox-agency -p 'test_*.py' && python3 -m unittest discover -s hermes/runtime -p 'test_*.py'",
    "test:watch": "vitest",
    "eval": "tsx scripts/run-evals.ts",
    "verify:production": "tsx scripts/verify-production.ts",
    "release:identity": "tsx scripts/generate-release-identity.ts",
    "verify:security-contracts": "tsx scripts/verify-security-contracts.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "receipt-proxy": "tsx scripts/hermes-receipt-proxy.ts",
    "worker": "tsx scripts/whitebox-worker.ts"
  },
  "dependencies": {
    "convex": "^1.31.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/vscode": "^1.125.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
